; Standalone request documents for scenarios 01-06 of ../scenarios/demo.json:
; exactly what the adapter sends on the kernel's stdin (facts.source =
; "fixture"). Each file must equal what `authority_kernel request` builds from
; demo.json, and deciding it must give ../scenarios/expected/<name>.json.
; Regenerate with `dune build @examples/requests/runtest` and `dune promote`.

(rule
 (with-stdout-to
  01-direct-read.json.gen
  (run %{dep:../../bin/authority_kernel/main.exe} request %{dep:../scenarios/demo.json} 01-direct-read)))

(rule
 (alias runtest)
 (action
  (diff 01-direct-read.json 01-direct-read.json.gen)))

(rule
 (with-stdout-to
  01-direct-read.decision.out
  (run %{dep:../../bin/authority_kernel/main.exe} eval %{dep:01-direct-read.json})))

(rule
 (alias runtest)
 (action
  (diff %{dep:../scenarios/expected/01-direct-read.json} 01-direct-read.decision.out)))

(rule
