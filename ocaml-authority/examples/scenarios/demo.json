{
  "schema": "typed-authority/scenarios/v1",
  "ledger": {
    "schema": "typed-authority/ledger/v1",
    "principals": [
      { "type": "user", "id": "samantha" },
      { "type": "service", "id": "research-agent" }
    ],
    "mandates": [
      { "id": "generate-report",
        "purpose": "Produce the quarterly report for internal review",
        "capabilities": [ { "resource_type": "document", "action": "read" },
                          { "resource_type": "document", "action": "generate" } ],
        "effects": [ { "kind": "observe" },
                     { "kind": "produce", "audience": "organization" } ] },
      { "id": "publish-release",
        "purpose": "Publish an approved release to the public",
        "capabilities": [ { "resource_type": "document", "action": "publish" } ],
        "effects": [ { "kind": "disclose", "audience": "public" } ] },
      { "id": "operate-realm",
        "purpose": "Change the configuration of the realm",
        "capabilities": [ { "resource_type": "admin-surface", "action": "administer" } ],
        "effects": [ { "kind": "administer" } ] }
    ],
    "grants": [
      { "id": "g-samantha-read",
        "holder": { "type": "user", "id": "samantha" },
        "capability": { "resource_type": "document", "action": "read" },
        "target": "any",
        "mandates": [ "generate-report" ],
        "effects": [ { "kind": "observe" } ],
        "delegable_depth": 1,
        "provenance": { "kind": "root", "anchor": { "realm_role": "report-author" } } },
      { "id": "g-samantha-generate",
        "holder": { "type": "user", "id": "samantha" },
        "capability": { "resource_type": "document", "action": "generate" },
        "target": "any",
        "mandates": [ "generate-report" ],
        "effects": [ { "kind": "produce", "audience": "organization" } ],
        "delegable_depth": 1,
        "provenance": { "kind": "root", "anchor": { "realm_role": "report-author" } } },
      { "id": "g-samantha-publish",
        "holder": { "type": "user", "id": "samantha" },
        "capability": { "resource_type": "document", "action": "publish" },
        "target": "any",
        "mandates": [ "publish-release" ],
        "effects": [ { "kind": "disclose", "audience": "public" } ],
        "provenance": { "kind": "root", "anchor": { "realm_role": "document-publisher" } } },
      { "id": "g-samantha-administer",
        "holder": { "type": "user", "id": "samantha" },
        "capability": { "resource_type": "admin-surface", "action": "administer" },
        "target": "any",
        "mandates": [ "operate-realm" ],
        "effects": [ { "kind": "administer" } ],
        "provenance": { "kind": "root", "anchor": { "realm_role": "realm-operator" } } },
      { "id": "g-agent-read",
        "holder": { "type": "service", "id": "research-agent" },
        "capability": { "resource_type": "document", "action": "read" },
        "target": "any",
        "mandates": [ "generate-report" ],
        "effects": [ { "kind": "observe" } ],
        "provenance": { "kind": "root",
                        "anchor": { "client_role": { "client": "document-service", "role": "reader" } } } },
      { "id": "d-agent-generate",
        "holder": { "type": "service", "id": "research-agent" },
        "capability": { "resource_type": "document", "action": "generate" },
        "target": { "resource": "q3-report" },
        "mandates": [ "generate-report" ],
        "effects": [ { "kind": "produce", "audience": "organization" } ],
        "valid_from": "2026-09-01T00:00:00Z",
        "valid_until": "2026-12-31T23:59:59Z",
        "provenance": { "kind": "delegated", "parent": "g-samantha-generate",
                        "delegator": { "type": "user", "id": "samantha" } } },
      { "id": "d-agent-read",
        "holder": { "type": "service", "id": "research-agent" },
        "capability": { "resource_type": "document", "action": "read" },
        "target": { "resource": "q3-report" },
        "mandates": [ "generate-report" ],
        "effects": [ { "kind": "observe" } ],
        "valid_from": "2026-04-01T00:00:00Z",
        "valid_until": "2026-06-30T00:00:00Z",
        "provenance": { "kind": "delegated", "parent": "g-samantha-read",
                        "delegator": { "type": "user", "id": "samantha" } } },
      { "id": "u-agent-publish",
        "holder": { "type": "service", "id": "research-agent" },
        "capability": { "resource_type": "document", "action": "publish" },
        "target": { "resource": "q3-report" },
        "mandates": [ "publish-release" ],
        "effects": [ { "kind": "disclose", "audience": "public" } ] }
    ],
    "revocations": [],
    "prohibitions": []
  },
  "defaults": {
    "facts": {
      "source": "fixture",
      "realm": "typed-authority-demo",
      "evaluated_at": "2026-09-29T12:00:00Z",
      "subject": { "type": "service", "id": "research-agent" },
      "actor_chain": [],
      "principals": [
        { "type": "user", "id": "samantha",
          "realm_roles": [ "report-author", "document-publisher", "realm-operator" ],
          "client_roles": {} },
        { "type": "service", "id": "research-agent",
          "realm_roles": [],
          "client_roles": { "document-service": [ "reader" ] } }
      ]
    }
  },
  "scenarios": [
    { "name": "01-direct-read",
      "description": "research-agent, with its own token, reads q3-report under generate-report. Its root grant is anchored in the client role document-service:reader.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "read" },
                 "resource": "q3-report",
                 "effect": { "kind": "observe" } },
      "facts": { "subject": { "type": "service", "id": "research-agent" }, "actor_chain": [] },
      "expect": "allow" },

    { "name": "02-delegated-generate",
      "description": "research-agent acts for samantha (token exchange) and generates q3-report for the organization. Authority: samantha's root grant (report-author) delegated to the agent.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "generate" },
                 "resource": "q3-report",
                 "effect": { "kind": "produce", "audience": "organization" } },
      "facts": { "subject": { "type": "user", "id": "samantha" },
                 "actor_chain": [ { "type": "service", "id": "research-agent" } ] },
      "expect": "allow" },

    { "name": "03-capability-denied",
      "description": "research-agent, with its own token, administers realm-config under operate-realm. It holds no administer grant.",
      "query": { "mandate": "operate-realm",
                 "capability": { "resource_type": "admin-surface", "action": "administer" },
                 "resource": "realm-config",
                 "effect": { "kind": "administer" } },
      "facts": { "subject": { "type": "service", "id": "research-agent" }, "actor_chain": [] },
      "expect": "deny",
      "expect_reasons": [ "no_grant_for_capability" ] },

    { "name": "04-wrong-effect",
      "description": "research-agent acts for samantha and generates q3-report for the public. The mandate and the delegated grant bound produce to organization.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "generate" },
                 "resource": "q3-report",
                 "effect": { "kind": "produce", "audience": "public" } },
      "facts": { "subject": { "type": "user", "id": "samantha" },
                 "actor_chain": [ { "type": "service", "id": "research-agent" } ] },
      "expect": "deny",
      "expect_reasons": [ "effect_within_mandate", "effect_within_grant" ] },

    { "name": "05-expired-delegation",
      "description": "research-agent acts for samantha and reads q3-report. The read delegation expired on 2026-06-30; the agent's own read grant is not usable while it acts for samantha.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "read" },
                 "resource": "q3-report",
                 "effect": { "kind": "observe" } },
      "facts": { "subject": { "type": "user", "id": "samantha" },
                 "actor_chain": [ { "type": "service", "id": "research-agent" } ] },
      "expect": "deny",
      "expect_reasons": [ "expired", "delegation_path_matches" ] },

    { "name": "06-missing-provenance",
      "description": "research-agent, with its own token, publishes q3-report under publish-release. The only publish entry it holds has no provenance.",
      "query": { "mandate": "publish-release",
                 "capability": { "resource_type": "document", "action": "publish" },
                 "resource": "q3-report",
                 "effect": { "kind": "disclose", "audience": "public" } },
      "facts": { "subject": { "type": "service", "id": "research-agent" }, "actor_chain": [] },
      "expect": "indeterminate",
      "expect_reasons": [ "insufficient_evidence" ] },

    { "name": "07-mandate-capability-mismatch",
      "description": "research-agent acts for samantha and publishes q3-report publicly under generate-report. The mandate permits report generation; it does not authorize public publication.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "publish" },
                 "resource": "q3-report",
                 "effect": { "kind": "disclose", "audience": "public" } },
      "facts": { "subject": { "type": "user", "id": "samantha" },
                 "actor_chain": [ { "type": "service", "id": "research-agent" } ] },
      "expect": "deny",
      "expect_reasons": [ "mandate_covers_capability", "effect_within_mandate" ] },

    { "name": "08-confused-deputy",
      "description": "On 2026-03-16, before samantha delegated read access (valid from 2026-04-01), research-agent acts for samantha and reads q3-report. The only authority it could use is its own reader grant, which is not usable on samantha's behalf.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "read" },
                 "resource": "q3-report",
                 "effect": { "kind": "observe" } },
      "facts": { "evaluated_at": "2026-03-16T09:00:00Z",
                 "subject": { "type": "user", "id": "samantha" },
                 "actor_chain": [ { "type": "service", "id": "research-agent" } ] },
      "expect": "deny",
      "expect_reasons": [ "delegation_path_matches", "not_yet_valid" ] },

    { "name": "09-anchor-role-removed",
      "description": "As 02, but the live role mappings show samantha no longer holds report-author. The ledger is unchanged.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "generate" },
                 "resource": "q3-report",
                 "effect": { "kind": "produce", "audience": "organization" } },
      "facts": { "subject": { "type": "user", "id": "samantha" },
                 "actor_chain": [ { "type": "service", "id": "research-agent" } ],
                 "principals": [
                   { "type": "user", "id": "samantha",
                     "realm_roles": [ "document-publisher", "realm-operator" ],
                     "client_roles": {} },
                   { "type": "service", "id": "research-agent",
                     "realm_roles": [],
                     "client_roles": { "document-service": [ "reader" ] } } ] },
      "expect": "deny",
      "expect_reasons": [ "anchor_missing" ] },

    { "name": "10-unknown-principal",
      "description": "mallory, a Keycloak user holding report-author but absent from the ledger, reads q3-report.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "read" },
                 "resource": "q3-report",
                 "effect": { "kind": "observe" } },
      "facts": { "subject": { "type": "user", "id": "mallory" },
                 "actor_chain": [],
                 "principals": [
                   { "type": "user", "id": "mallory",
                     "realm_roles": [ "report-author" ],
                     "client_roles": {} } ] },
      "expect": "indeterminate",
      "expect_reasons": [ "unknown_principal" ] },

    { "name": "11-missing-effect",
      "description": "research-agent, with its own token, reads q3-report without declaring an effect.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "read" },
                 "resource": "q3-report" },
      "facts": { "subject": { "type": "service", "id": "research-agent" }, "actor_chain": [] },
      "expect": "indeterminate",
      "expect_reasons": [ "missing_effect" ] },

    { "name": "12-direct-publish",
      "description": "samantha, with her own token, publishes q3-report under publish-release. Contrast with 07: the same capability and effect, exercised by its holder under the mandate that covers it.",
      "query": { "mandate": "publish-release",
                 "capability": { "resource_type": "document", "action": "publish" },
                 "resource": "q3-report",
                 "effect": { "kind": "disclose", "audience": "public" } },
      "facts": { "subject": { "type": "user", "id": "samantha" }, "actor_chain": [] },
      "expect": "allow" },

    { "name": "13-delegation-without-exchange",
      "description": "research-agent uses the generate delegation from samantha with its own token, i.e. without a token exchange proving it currently acts for her.",
      "query": { "mandate": "generate-report",
                 "capability": { "resource_type": "document", "action": "generate" },
                 "resource": "q3-report",
                 "effect": { "kind": "produce", "audience": "organization" } },
      "facts": { "subject": { "type": "service", "id": "research-agent" }, "actor_chain": [] },
      "expect": "deny",
      "expect_reasons": [ "delegation_path_matches" ] }
  ]
}
