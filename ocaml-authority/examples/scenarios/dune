; Captured kernel outputs. For every scenario in demo.json the CLI builds the
; request document (`request`) and decides it (`eval`, `eval --text`), exactly
; as the adapter path does; the results are compared with expected/. The files
; in expected/ are produced only by these rules: after an intended change, run
; `dune build @examples/scenarios/runtest` and then `dune promote`.

(rule
 (alias runtest)
 (action
  (run %{dep:../../bin/authority_kernel/main.exe} scenarios %{dep:demo.json} --check)))

(rule
 (with-stdout-to
  compare.md.out
  (run %{dep:../../bin/authority_kernel/main.exe} compare %{dep:demo.json})))

(rule
 (alias runtest)
 (action
  (diff expected/compare.md compare.md.out)))

(rule
 (with-stdout-to
  surface.txt.out
  (run %{dep:../../bin/authority_kernel/main.exe} surface %{dep:demo.json})))

(rule
 (alias runtest)
 (action
  (diff expected/surface.txt surface.txt.out)))

(rule
 (with-stdout-to
  01-direct-read.json.out
  (pipe-stdout
   (run %{dep:../../bin/authority_kernel/main.exe} request %{dep:demo.json} 01-direct-read)
   (run %{dep:../../bin/authority_kernel/main.exe} eval))))

(rule
 (with-stdout-to
  01-direct-read.txt.out
  (pipe-stdout
   (run %{dep:../../bin/authority_kernel/main.exe} request %{dep:demo.json} 01-direct-read)
   (run %{dep:../../bin/authority_kernel/main.exe} eval --text))))

(rule
 (alias runtest)
 (action
  (diff expected/01-direct-read.json 01-direct-read.json.out)))

(rule
 (alias runtest)
 (action
  (diff expected/01-direct-read.txt 01-direct-read.txt.out)))

