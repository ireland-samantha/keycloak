; Hypothesis W4: which dimension of the model decided each scenario. The
; ablation fails outright if a decision's evidence cannot reproduce it.
(rule
 (with-stdout-to
  ablation.md.out
  (run %{dep:../../bin/authority_kernel/main.exe} ablate %{dep:demo.json})))

(rule
 (alias runtest)
 (action
  (diff expected/ablation.md ablation.md.out)))
